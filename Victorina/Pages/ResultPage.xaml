<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Victorina.Pages.ResultPage"
             Title="Результаты">
    <VerticalStackLayout Padding="20" Spacing="20" Background="DodgerBlue"
                         VerticalOptions="Center">
        <Label x:Name="ResultLabel" FontSize="32"
               HorizontalOptions="Center"/>
        <Button Text="Вернуться на главную страницу" Clicked="OnRestartClicked" Background="DarkBlue"/>

    </VerticalStackLayout>
</ContentPage>