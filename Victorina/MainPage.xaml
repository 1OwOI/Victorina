<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Victorina.MainPage"
             Title="Victorina">
    <StackLayout Background="DodgerBlue"  HorizontalOptions="Center">
        <Label Text="Проверь свои знания!" Padding="20"
               FontAttributes="Bold"
               FontSize="34"
               HorizontalOptions="Center"/>

        <Label Text="Проверь свои знания ответив на вопросы. В тесте вас ждёт 15 вопрос на разнообразные темы, в некоторых нужно выбирать правильный ответ а в других вводить саомстоятельно!"
               FontSize="20"
               HorizontalOptions="Center"
               VerticalOptions="Center"/>

        <BoxView VerticalOptions="FillAndExpand"
                 Color="Transparent"/>


            <Button Text="Начать Тест" Background="DarkBlue"
                    Clicked="OnStartClicked"/>
            <Button Text="Справка" Background="DarkSlateBlue"
                    Clicked="Button_Clicked"/>
        </StackLayout>
</ContentPage>
